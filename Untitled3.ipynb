    "from json import load, dump\n",
    "with open('Untitled-Copy3.ipynb', 'r+', encoding='utf8') as f:\n",
    "    a = load(f)\n",
    "    for i in a['cells']:\n",
    "        i['outputs'] = []\n",
    "    f.seek(0)\n",
    "    dump(a, f)\n",
    "    f.truncate()"
